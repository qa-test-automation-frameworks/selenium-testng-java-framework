<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Diagnostics Protection Chrome Control" parallel="none">
    <listeners>
        <listener class-name="io.github.selenium.saucedemo.framework.listener.SuiteConfigurationListener"/>
        <listener class-name="io.github.selenium.saucedemo.framework.listener.AnnotationTransformer"/>
        <listener class-name="io.github.selenium.saucedemo.framework.listener.FrameworkListener"/>
    </listeners>
    <test name="Synthetic DOM Protection">
        <classes>
            <class name="io.github.selenium.saucedemo.framework.util.DiagnosticsAttacherBrowserTests"/>
        </classes>
    </test>
</suite>
