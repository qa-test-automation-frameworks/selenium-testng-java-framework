<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Shared Reference Application" parallel="none" thread-count="1">
  <listeners>
    <listener class-name="io.github.selenium.saucedemo.framework.listener.SuiteConfigurationListener"/>
    <listener class-name="io.github.selenium.saucedemo.framework.listener.FrameworkListener"/>
  </listeners>
  <test name="Bounded Chrome Grid journeys">
    <classes>
      <class name="io.github.selenium.saucedemo.tests.SharedReferenceApplicationTests"/>
    </classes>
  </test>
</suite>
